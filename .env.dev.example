# Development environment. Usage: cp .env.dev.example .env && docker compose up -d
# Every variable is documented in .env.prod.example.

# Mailpit catches all outgoing mail: http://localhost:8025
COMPOSE_PROFILES=mailpit

# Local URL, plain HTTP on port 8104.
OC_URL=http://localhost:8104
SITE_ADDRESS=:80
HTTP_PORT=8104
HTTPS_PORT=8404
MAILPIT_PORT=8025

# Back office: http://localhost:8104/admin-dev/
OC_ADMIN_DIR=admin-dev

# Show errors (OpenCart and PHP). Never in production.
OC_DEBUG=1
PHP_DISPLAY_ERRORS=On

# Dev-only credentials.
DB_PASSWORD=opencart
DB_ROOT_PASSWORD=root
OC_ADMIN_USER=admin
OC_ADMIN_PASSWORD=admin12345
OC_ADMIN_EMAIL=admin@example.com

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=none
# OpenCart's SMTP client requires credentials; Mailpit accepts any.
SMTP_USER=dev
SMTP_PASSWORD=dev
SMTP_FROM=shop@example.com

# Optional overrides (see overrides/*.yaml), combined with ":".
#COMPOSE_FILE=compose.yaml:overrides/extension.yaml
#EXTENSION_PATH=../billmysales-plugin-opencart
#EXTENSION_NAME=billmysales
