# Production environment. Usage: cp .env.prod.example .env, fill in the
# REQUIRED values, then docker compose up -d
# Commented-out lines show the default value.

# ---------------------------------------------------------------------------
# Optional services, comma separated: backup, mailpit (dev only).
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=backup
#COMPOSE_PROJECT_NAME=opencart

# Optional overrides (see overrides/*.yaml), combined with ":", e.g.
#COMPOSE_FILE=compose.yaml:overrides/traefik.yaml:overrides/local-dirs.yaml
# overrides/traefik.yaml: publish through an existing Traefik (then set
# SITE_ADDRESS=:80 below).
#TRAEFIK_HOST=shop.example.com
#TRAEFIK_NETWORK=shared_network
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=letsencrypt
# overrides/local-dirs.yaml: data in local directories instead of volumes.
#DATA_DIR=./data

# ---------------------------------------------------------------------------
# Site and network
# ---------------------------------------------------------------------------
# REQUIRED. Public URL of the store (written to config.php on every `up`).
OC_URL=https://shop.example.com
# Caddy site address: a domain gets an automatic Let's Encrypt certificate
# (DNS must point here and ports 80/443 must be reachable). Use ":80" behind
# another TLS-terminating proxy, or "localhost" for local HTTPS.
SITE_ADDRESS=shop.example.com
# Interface to publish ports on: 0.0.0.0 = all (public server).
HTTP_BIND=0.0.0.0
#HTTP_PORT=80
#HTTPS_PORT=443

# ---------------------------------------------------------------------------
# Credentials and back office (REQUIRED)
# ---------------------------------------------------------------------------
# Use long random values: openssl rand -base64 24
DB_PASSWORD=
DB_ROOT_PASSWORD=
OC_ADMIN_PASSWORD=
OC_ADMIN_EMAIL=
# Back office directory name: keep it hard to guess, e.g. admin-$(openssl rand -hex 4)
OC_ADMIN_DIR=
#OC_ADMIN_USER=admin
#DB_NAME=opencart
#DB_USER=opencart

# ---------------------------------------------------------------------------
# Store (initial settings, applied only on the first install)
# ---------------------------------------------------------------------------
#OC_STORE_NAME=OpenCart
#OC_COUNTRY=CL
# Zone (region) code within the country.
#OC_ZONE=RM
#OC_CURRENCY=CLP
#OC_CURRENCY_TITLE=Peso chileno
#PHP_TIMEZONE=America/Santiago

# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------
# OpenCart release and its zip's SHA-256 (empty = don't verify). Only used
# when the code volume is created; afterwards OpenCart is upgraded from the
# back office (Maintenance > Upgrade).
#OC_VERSION=4.1.0.4
#OC_SHA256=cdef537f5a0a7e1b4ddbe16f589dd2e80b10150a09bfbe93ce76ef2d5c3218c0
#PHP_VERSION=8.5
# Image name for the built OpenCart image.
#OC_IMAGE=opencart-fpm
#CADDY_VERSION=2.11
#MARIADB_VERSION=12.3
#MAILPIT_VERSION=v1.31

# ---------------------------------------------------------------------------
# OpenCart / PHP
# ---------------------------------------------------------------------------
# Show errors (OpenCart's setting and PHP's display_errors): never in production.
#OC_DEBUG=0
#PHP_DISPLAY_ERRORS=Off
#PHP_MEMORY_LIMIT=256M
#PHP_MAX_EXECUTION_TIME=300
# Max upload/request size (PHP and Caddy).
#UPLOAD_MAX_SIZE=64M
# PHP-FPM pool. Rough sizing: max_children = RAM for PHP / ~60 MB per worker.
#PHP_FPM_MAX_CHILDREN=10
#PHP_FPM_START_SERVERS=2
#PHP_FPM_MIN_SPARE_SERVERS=1
#PHP_FPM_MAX_SPARE_SERVERS=4
#PHP_FPM_MAX_REQUESTS=500

# ---------------------------------------------------------------------------
# Mail (SMTP). When SMTP_HOST is set, these values replace the store's mail
# settings on every `up`.
# ---------------------------------------------------------------------------
SMTP_HOST=
#SMTP_PORT=587
# tls (STARTTLS), ssl (implicit TLS), none (or empty).
#SMTP_SECURE=tls
# OpenCart's SMTP client requires a username and password.
#SMTP_USER=
#SMTP_PASSWORD=
# Store email address (sender of the store's emails).
#SMTP_FROM=

# ---------------------------------------------------------------------------
# Cron and backups
# ---------------------------------------------------------------------------
#CRON_INTERVAL=300
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP_DAYS=7

# ---------------------------------------------------------------------------
# Resources and logs
# ---------------------------------------------------------------------------
#DB_MEMORY_LIMIT=1g
#OC_MEMORY_LIMIT=1g
#CADDY_MEMORY_LIMIT=256m
#CRON_MEMORY_LIMIT=512m
#BACKUP_MEMORY_LIMIT=512m
#LOG_MAX_SIZE=10m
#LOG_MAX_FILE=3
